rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────
    // Check if the requesting user is a Super Admin (role stored in their Firestore document or verified admin email)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['admin@career365compass.com', 'rahimskking@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN')
      );
    }

    // Check if the requesting user is a College Admin
    function isCollegeAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'COLLEGE_ADMIN' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'PENDING_COLLEGE_ADMIN');
    }

    // Check if the requesting user owns a specific resource
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── Colleges Collection ───────────────────────────────────────────
    // Public directory for students; College Admins & authenticated volunteers/students can submit pending colleges
    match /colleges/{collegeId} {
      allow read: if true;
      allow create: if isAdmin() ||
        (request.auth != null &&
         (request.resource.data.registeredByUid == request.auth.uid || request.resource.data.contributedByUid == request.auth.uid) &&
         request.resource.data.isApproved == false &&
         request.resource.data.status == 'PENDING');
      allow update: if isAdmin() ||
        (request.auth != null &&
         (resource.data.registeredByUid == request.auth.uid || resource.data.contributedByUid == request.auth.uid) &&
         resource.data.status == 'PENDING' &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'isApproved', 'verified', 'registeredByUid', 'contributedByUid']));
      allow delete: if isAdmin();
    }

    // ── Schools Collection ────────────────────────────────────────────
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Careers Collection ────────────────────────────────────────────
    match /careers/{careerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Scholarships Collection ───────────────────────────────────────
    match /scholarships/{scholarshipId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Admission Updates Collection ──────────────────────────────────
    match /admission-updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Competitive Exams Collection ──────────────────────────────────
    match /competitive-exams/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Reviews Collection ────────────────────────────────────────────
    // Anyone can read; authenticated users can submit pending reviews; only author or admin can modify
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.isApproved == false &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update: if isAdmin() ||
        (request.auth != null &&
         resource.data.userId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isApproved', 'userId', 'collegeId']));
      allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── Users Collection ──────────────────────────────────────────────
    // Users can only read/manage their own document; admins have full visibility
    // Strict separation of create/update to prevent self-role-escalation bypass
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        (!request.resource.data.keys().hasAny(['role']) ||
         request.resource.data.role in ['STUDENT', 'PENDING_COLLEGE_ADMIN']);
      allow update: if (isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'email'])))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Surveys Collection ────────────────────────────────────────────
    // Only one survey per student (surveyId == request.auth.uid); admins have full read/manage
    match /surveys/{surveyId} {
      allow read: if isAdmin() || (request.auth != null && (surveyId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create, update: if isAdmin() || (
        request.auth != null &&
        (surveyId == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
        request.resource.data.q1_fullName is string &&
        request.resource.data.q1_fullName.size() > 0 &&
        request.resource.data.q1_fullName.size() < 100 &&
        request.resource.data.keys().size() < 60
      );
      allow delete: if isAdmin();
    }

    // ── Phone Registry Collection ─────────────────────────────────────
    // Used to enforce unique mobile numbers across student accounts and allow phone login
    match /phone_registry/{mobileNumber} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // ── Audit Logs Collection ─────────────────────────────────────────
    // Append-only immutable audit trail; only admins can write and read; no deletion/updates
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
