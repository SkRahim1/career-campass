rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public directories: Anyone can view colleges, careers, scholarships, admission updates, and schools
    match /colleges/{collegeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /schools/{schoolId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /careers/{careerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /scholarships/{scholarshipId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /admission-updates/{updateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /competitive-exams/{examId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reviews: Anyone can read; logged-in users can submit and moderate
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // User profiles & bookmarks: Logged-in students can create and manage their profile
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Surveys: Anyone can submit a survey response; authenticated users / admin can read
    match /surveys/{surveyId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
